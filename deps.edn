{:paths ["src" "resources"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.5"}

  ;; Malli schema engine — the substrate every hive-schemas lever wraps.
  metosin/malli {:mvn/version "0.20.1"}

  ;; test.check — malli.generator target; kept in CORE so the schema->generator
  ;; lever works without the (heavier) test-synth alias.
  org.clojure/test.check {:mvn/version "1.1.3"}

  ;; hive-spi.schema.{registry,derive,gen,typed} — the single-source levers.
  ;; Published on Clojars; transitively pulls hive-dsl (Result).
  io.github.hive-agi/hive-spi {:mvn/version "0.1.20"}}

 ;; The optional layers live in SIBLING source roots (synth/ ansatz/ typed/
 ;; raster/),
 ;; never nested under src/. A root inside another root is copied twice by the
 ;; jar step — once at its own path and once under the outer root's prefix,
 ;; where the namespace no longer resolves.
 :aliases
 {;; OPTIONAL submodule: schema -> hive-test test synthesis. Pulls hive-test
  ;; (the test-paradigm lib). Core stays test-lib-free.
  :test-synth
  {:extra-paths ["synth"]
   :extra-deps  {io.github.hive-agi/hive-test {:mvn/version "0.3.14"}}}

  ;; OPTIONAL submodule: differential verification facet (ladder rung E).
  ;; hive-schemas.verified wraps ansatz.malli/check-verified! — compiled runtime
  ;; vs Lean 4 CIC kernel whnf on generated inputs. Pulls ansatz (the kernel).
  ;; Scope: Nat/Bool/List Nat. Core + test-synth stay ansatz-free.
  :ansatz
  {:extra-paths ["ansatz"]
   :extra-deps  {org.replikativ/ansatz {:mvn/version "0.2.84"}}}

  ;; OPTIONAL submodule: raster bridge. hive-schemas.raster derives a malli
  ;; schema from a raster `deftm` overload's signature, so a numeric kernel gets
  ;; the synthesis ladder without a hand-written generator. Pulls raster (which
  ;; pulls typed.clj.checker transitively — the same 1.4.0 the :typed alias
  ;; pins). Core stays raster-free.
  ;;
  ;; raster is UPSTREAM (replikativ), not a hive lib: pinned by :mvn/version
  ;; here, and a working copy is wired through an untracked local.deps.edn
  ;; override (see :local-raster there) rather than a :local/root in this file.
  :raster
  {:extra-paths ["raster"]
   :extra-deps  {org.replikativ/raster {:mvn/version "0.2.318"}}
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED"
                 "--add-modules=jdk.incubator.vector"
                 "-Xss8m"]}

  ;; OPTIONAL submodule: static-type facet (ladder rung D). hive-schemas.typed-check
  ;; runs the Typed Clojure checker over a namespace and reports its errors as a
  ;; test facet. Pulls typed.clj.checker. Core + test-synth stay checker-free.
  :typed
  {:extra-paths ["typed"]
   :extra-deps  {org.typedclojure/typed.clj.checker {:mvn/version "1.4.0"}}}

  ;; Rung-E PROOF suite: boots the ansatz kernel and runs the differential
  ;; facet against a real a/defn subject (test-ansatz/, its own kaocha config).
  ;; Self-contained — pulls ansatz/ + the kernel + hive-test + kaocha. Kept
  ;; separate from :test so the pinned Maven build stays kernel-free.
  :ansatz-test
  {:extra-paths ["ansatz" "synth" "test-ansatz"]
   :extra-deps  {org.replikativ/ansatz {:mvn/version "0.2.84"}
                 io.github.hive-agi/hive-test {:mvn/version "0.3.14"}
                 lambdaisland/kaocha {:mvn/version "1.91.1392"}}
   :main-opts   ["-m" "kaocha.runner" "--config-file" "tests.ansatz.edn"]}

  :test
  {:extra-paths ["synth" "test"]
   :extra-deps  {io.github.hive-agi/hive-test {:mvn/version "0.3.14"}
                 lambdaisland/kaocha {:mvn/version "1.91.1392"}}
   :main-opts   ["-m" "kaocha.runner"]}

  :nrepl
  {:extra-paths ["synth" "dev" "test"]
   :extra-deps  {io.github.hive-agi/hive-test {:mvn/version "0.3.14"}
                 nrepl/nrepl       {:mvn/version "1.7.0"}
                 cider/cider-nrepl {:mvn/version "0.62.2"}}
   :main-opts   ["-m" "nrepl.cmdline"
                 "--middleware" "[cider.nrepl/cider-middleware]"
                 "--port" "7956"]}

  ;; Clojars publishing. version = the repo's VERSION file.
  ;; Ships every root version.edn :src-dirs names — src + synth + ansatz + typed
  ;; + raster. Their heavy deps (hive-test, ansatz, typed.clj.checker, raster)
  ;; are OPTIONAL — the consumer adds whichever layer it uses.
  :build
  {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.10"}}
   :ns-default hive-build.api}

  ;; DEV co-development. deps.edn pins the PUBLISHED Maven coords (clean pom for
  ;; the Clojars jar), so editing a sibling normally needs a
  ;; `clojure -T:build install` round-trip into ~/.m2. This alias overrides the
  ;; hive-spi / hive-test coords with the sibling working copies, so their edits
  ;; are picked up live. :override-deps replaces the coordinate everywhere in the
  ;; tree, so it composes with any alias:
  ;;   clojure -M:test:local     ; kaocha against ../hive-spi + ../hive-test
  ;;   clojure -M:nrepl:local    ; REPL against the locals
  ;; Drop :local to build/deploy/verify against the pinned Maven versions.
  :local
  {:override-deps {io.github.hive-agi/hive-spi  {:local/root "../hive-spi"}
                   io.github.hive-agi/hive-test {:local/root "../hive-test"}}}
  ;; Rung-4/5 suite for the raster bridge: the malli <-> deftm projections
  ;; checked against REAL raster kernels, the trifecta defkernel-trifecta
  ;; synthesizes for one, and the rung-D facet over a raster-typed namespace.
  ;; Own test root + kaocha config, kept out of :test so the default lane stays
  ;; raster-free (raster pulls typed.clj.checker and needs
  ;; --enable-native-access). typed/ rides along because raster already brings
  ;; typed.clj.checker transitively.
  :raster-test
  {:extra-paths ["raster" "synth" "typed" "test/raster"]
   :extra-deps  {org.replikativ/raster {:mvn/version "0.2.318"}
                 io.github.hive-agi/hive-test {:mvn/version "0.3.14"}
                 lambdaisland/kaocha {:mvn/version "1.91.1392"}}
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED"
                 "--add-modules=jdk.incubator.vector"
                 "-Xss8m"]
   :main-opts   ["-m" "kaocha.runner" "--config-file" "tests.raster.edn"]}}}
